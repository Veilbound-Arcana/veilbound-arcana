{
  "name": "veilbound-arcana",
  "version": "1.0.0",
  "description": "Veilbound Arcana — Confidential Tarot TCG on Zama Protocol (Sepolia Testnet)",
  "private": true,
  "workspaces": [
    "contracts",
    "backend",
    "frontend",
    "sdk",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "demo:replay": "node scripts/demo-replay.mjs",
    "verify:thesis": "node scripts/verify-claims.mjs",
    "contracts:compile": "npm run compile --workspace=contracts",
    "contracts:test": "npm run test --workspace=contracts",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "sdk:build": "npm run build --workspace=sdk"
  },
  "keywords": [
    "fhevm",
    "zama",
    "confidential-gaming",
    "tcg",
    "tarot",
    "sepolia",
    "erc-7984",
    "erc-721"
  ],
  "author": "Veilbound Arcana Team (Arya, Yavin, Adrian)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
