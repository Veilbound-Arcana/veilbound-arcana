{
  "name": "@veilbound/frontend",
  "version": "1.0.0",
  "description": "Veilbound Arcana — Original Mobile Collectible-Card Game Frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
